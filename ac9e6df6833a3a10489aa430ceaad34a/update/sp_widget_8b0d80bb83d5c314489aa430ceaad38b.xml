        <script><![CDATA[(function() {
  data.incidents = [];
  var gr = new GlideRecord('incident');
  gr.addActiveQuery();
  gr.orderByDesc('sys_created_on');
  gr.setLimit(10);
  gr.query();
  while (gr.next()) {
    var incident = {};
    incident.sys_id = gr.getUniqueValue();
    incident.number = gr.getValue('number');
    incident.short_description = gr.getValue('short_description');
    incident.state = gr.getDisplayValue('state');
    incident.priority = gr.getDisplayValue('priority');
    incident.caller = gr.getDisplayValue('caller_id');
    incident.created = gr.getDisplayValue('sys_created_on');
    data.incidents.push(incident);
  }
})();]]></script>
