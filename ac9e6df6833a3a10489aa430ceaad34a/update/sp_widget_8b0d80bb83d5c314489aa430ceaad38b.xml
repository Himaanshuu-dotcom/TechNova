        <template><![CDATA[<div class="panel panel-default b-r-2x shadow-lg"><div class="panel-heading text-center" style="background: linear-gradient(135deg, #7b2cbf 0%, #00f2fe 100%); padding: 15px; border-bottom: none;"><h3 class="panel-title" style="color: #ffffff; font-weight: 700; font-size: 1.4rem; letter-spacing: 0.05em; margin: 0;"><i class="fa fa-shield" style="margin-right: 8px;"></i> TECHNOVA ACTIVE INCIDENTS</h3></div><div class="list-group" style="margin-bottom: 0;"><div ng-repeat="inc in data.incidents" class="list-group-item" style="border-left: 4px solid #7b2cbf; margin-bottom: 2px; padding: 15px; transition: transform 0.2s ease-in-out;"><div class="row"><div class="col-xs-9"><h4 style="margin: 0 0 5px 0; font-weight: 600;"><span class="label label-primary" style="background-color: #00f2fe; color: #0b0813; font-weight: 700; margin-right: 5px;">{{inc.number}}</span>{{inc.short_description}}</h4><div class="text-muted" style="font-size: 0.85em;"><i class="fa fa-user-circle-o"></i> Caller: <strong>{{inc.caller}}</strong><span style="margin: 0 8px; color: #ccc;">|</span><i class="fa fa-clock-o"></i> Opened: {{inc.created}}</div></div><div class="col-xs-3 text-right"><span class="label label-danger" ng-if="inc.priority.indexOf('1') > -1 || inc.priority.indexOf('2') > -1" style="font-weight: 700; padding: 5px 10px;">{{inc.priority}}</span><span class="label label-warning" ng-if="inc.priority.indexOf('3') > -1" style="font-weight: 700; padding: 5px 10px; background-color: #f59e0b;">{{inc.priority}}</span><span class="label label-info" ng-if="inc.priority.indexOf('1') == -1 && inc.priority.indexOf('2') == -1 && inc.priority.indexOf('3') == -1" style="font-weight: 700; padding: 5px 10px; background-color: #3b82f6;">{{inc.priority}}</span></div></div></div><div ng-if="data.incidents.length == 0" class="list-group-item text-center text-muted" style="padding: 30px;">No active incidents registered. System status is normal.</div></div></div>]]></template>
