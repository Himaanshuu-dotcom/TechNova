        <script><![CDATA[(function() {
  data.table = "incident";
  data.fields = ["number", "short_description", "state", "priority", "caller_id", "opened_at"]; // 6 columns
  data.query = "active=true"; // edit filter here
  data.limit = 10; // edit limit here

  var gr = new GlideRecord(data.table);
  gr.addEncodedQuery(data.query);
  gr.orderByDesc("opened_at");
  gr.setLimit(data.limit);
  gr.query();

  data.rows = [];
  while (gr.next()) {
    var row = {};
    data.fields.forEach(function(f) {
      row[f] = gr.getDisplayValue(f);
    });
    data.rows.push(row);
  }
})();]]></script>
